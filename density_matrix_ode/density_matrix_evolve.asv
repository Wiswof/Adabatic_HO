clear;clc;close all

load('density_matrix_ode/step1.mat')


Gamma_m=0.2;

A_even=zeros(N_state,N_state);
A_even(3:2*N_state+2:end-N_state)=1;
A_even=A_even';
A_odd=zeros(N_state,N_state);
A_odd(4+N_state:2*N_state+2:end)=1;
A_odd=A_odd';
A_R=A_even+A_odd;
A_L=A_even-A_odd;

tspan = [0, 1000];% time span
h = tspan(2)/1000; %dtspan

rho0 = zeros(N_state,N_state);
rho0(1)=1;
Alphat_shift=1e-6;
%fdrho(rho0,Energy_spectrum,ial,inner_matrix_t,ial0,tspan,Dalpha)
odefun = @(t, rho) fdrho(rho,Energy_spectrum,ial,inner_matrix_t,...
                   1+Alphat_shift+t*(Dalpha-Alphat_shift)/tspan(end),...
                   tspan,Dalpha-Alphat_shift,A_L,A_R,Gamma_m);


% 调用Runge-Kutta函数
[t, rhot] = rungeKutta4(odefun, tspan, rho0, h);

% 绘制解
%plot(t, y);
% xlabel('Time t');
% ylabel('Solution y');
% title('Solution of ODE using Runge-Kutta 4th Order Method');


read_out



function drho=fdrho(rho,Energy_spectrum,ial,inner_matrix_t,ial0,tspan,Dalpha,A_L,A_R,Gamma_m)

[~,p_ial0]=min(abs(ial-ial0));
dalpha_dt= Dalpha/tspan(end);
M_matrix=inner_matrix_t{p_ial0}*dalpha_dt;
H_matrix=diag(Energy_spectrum(:,p_ial0));
drho1=-1j*(H_matrix*rho-rho*H_matrix)-M_matrix*rho-rho*M_matrix';
drho2=Gamma_m*(A_R*rho*A_R'-1/2*(A_R'*A_R*rho+rho*A_R'*A_R))...
     +Gamma_m*(A_L*rho*A_L'-1/2*(A_L'*A_L*rho+rho*A_L'*A_L))  ;
drho=drho1+drho2;
end

function [t, y] = rungeKutta4(odefun, tspan, y0, h)
    % odefun - 函数句柄，表示微分方程的右侧 (dy/dt = f(t, y))
    % tspan  - 时间范围 [t0, tf]
    % y0     - 初始条件
    % h      - 步长
    
    t0 = tspan(1);
    tf = tspan(2);
    
    % 计算步数
    n = round((tf - t0) / h);
    
    % 初始化时间和解向量
    t = zeros(1, n+1);
    y = cell(1,n+1);
    
    % 设置初始条件
    t(1) = t0;
    y{1} = y0;
    
    for i = 1:n
        ti = t(i);
        yi = y{i};
        
        % 计算k1, k2, k3, k4
        k1 = odefun(ti, yi);
        k2 = odefun(ti + h/2, yi + h/2 * k1);
        k3 = odefun(ti + h/2, yi + h/2 * k2);
        k4 = odefun(ti + h, yi + h * k3);
        
        % 更新解
        y{i+1} = yi + h/6 * (k1 + 2*k2 + 2*k3 + k4);
        t(i+1) = ti + h;
    end
end