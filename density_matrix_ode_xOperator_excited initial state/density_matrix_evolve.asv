clearvars  -except Gamma_m iG Gamma_mset tspan iT tspan_set
close all
tic
load('density_matrix_ode_xOperator_excited initial state/step1_100state_dalpha_8e-4.mat')
%load('density_matrix_ode_xOperator_excited initial state/step1_100state.mat')

%%%%%%%%%%%%%%%%%%%%
 Gamma_m=2.5*10^-3;
%%%%%%%%%%%%%%%%%%%

% tspan = [0, 0.8];% time span


h = min(1/Vpar.Omega/5,tspan(2)/1000);%0.0005;%tspan(2)/10000; %dtspan  %10000  %10000

%% initial state

d2dx2 = sparse([[1:N],[2:N],[1:N-1]],   [[1:N],[1:N-1],[2:N]],...
    [[-2*ones(1,N),1*ones(1,N-1),1*ones(1,N-1)]],N,N); %-2*diag(ones(1, N)) + diag(ones(1, N-1), 1) + diag(ones(1, N-1), -1);
d2dx2 = d2dx2 / dx^2;
T_0 = -hbar^2 / (2*m) * d2dx2;

% Construct the potential energy matrix V
V_0 = sparse([1:N],[1:N],FV_alpha(1),N,N);   %diag(V);
H_0 =T_0+V_0;

clearvars d2dx2 T_0 V_0
Omega_ini=1;
Psi_peak_ini=(Omega_ini/pi)^0.25*exp(-Omega_ini*x.^2/2)';
Psi_peak_ini=Psi_peak_ini/sqrt(Psi_peak_ini'*Psi_peak_ini);
E_peak_ini=Psi_peak_ini'*H_0*Psi_peak_ini;

%%
% Ci_Psi_peak_ini=Psi_peak_ini'*eigenfunctions;
% 
% rho0=Ci_Psi_peak_ini'*Ci_Psi_peak_ini;
% rho0=rho0/trace(rho0);
%%

rho0 = zeros(N_state,N_state);
rho0(1)=1;

%%
Alphat_shift=0;
%fdrho(rho0,Energy_spectrum,ial,inner_matrix_t,ial0,tspan,Dalpha)
odefun = @(t, rho) fdrho(rho,Energy_spectrum,ial,inner_matrix_t,...
                   1+Alphat_shift+t*(Dalpha-Alphat_shift)/tspan(end),...
                   tspan,Dalpha-Alphat_shift,Opera_q_t,Gamma_m,Vpar);


% 调用Runge-Kutta函数
[t, rhot] = rungeKutta4(odefun, tspan, rho0, h);

fprintf('ODE done \n')
toc

% 绘制解
%plot(t, y);
% xlabel('Time t');
% ylabel('Solution y');
% title('Solution of ODE using Runge-Kutta 4th Order Method');


read_out


%%
function drho=fdrho(rho,Energy_spectrum,ial,inner_matrix_t,ial0,tspan,Dalpha,Opera_q_t,Gamma_m,Vpar)

[~,p_ial0]=min(abs(ial-ial0));
dalpha_dt= Dalpha/tspan(end);

M_matrix=inner_matrix_t{p_ial0}*dalpha_dt;
AA=Opera_q_t{p_ial0};
H_matrix=diag(Energy_spectrum(:,p_ial0))*Vpar.Omega;
drho1=-1j*(H_matrix*rho-rho*H_matrix)-M_matrix*rho-rho*M_matrix';
drho2=Gamma_m*(AA*rho*AA'-1/2*(AA'*AA*rho+rho*AA'*AA));
drho=drho1+drho2;
end

function [t, y] = rungeKutta4(odefun, tspan, y0, h)
    % odefun - 函数句柄，表示微分方程的右侧 (dy/dt = f(t, y))
    % tspan  - 时间范围 [t0, tf]
    % y0     - 初始条件
    % h      - 步长
    
    t0 = tspan(1);
    tf = tspan(2);
    
    % 计算步数
    n = round((tf - t0) / h);
    
    % 初始化时间和解向量
    t = zeros(1, n+1);
    y = cell(1,n+1);
    
    % 设置初始条件
    t(1) = t0;
    y{1} = y0;
    
    for i = 1:n
        ti = t(i);
        yi = y{i};
        
        % 计算k1, k2, k3, k4
        k1 = odefun(ti, yi);
        k2 = odefun(ti + h/2, yi + h/2 * k1);
        k3 = odefun(ti + h/2, yi + h/2 * k2);
        k4 = odefun(ti + h, yi + h * k3);
        
        % 更新解
        y{i+1} = yi + h/6 * (k1 + 2*k2 + 2*k3 + k4);
        t(i+1) = ti + h;
    end
end